# ==============================================================================
# SentinelVault Enterprise Zero-Trust Cloud Storage Configuration
# ==============================================================================

# Application Settings
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=enter-a-cryptographically-secure-random-256-bit-hex-key-here
JWT_SECRET_KEY=enter-a-cryptographically-secure-random-jwt-key-here

# Database Configuration (Runs 100% locally FREE with SQLite by default)
DATABASE_URI=sqlite:///database.db

# Storage Pathways (Local simulation with future AWS S3 drop-in compatibility)
UPLOAD_FOLDER=uploads
ENCRYPTED_FOLDER=encrypted
DECRYPTED_FOLDER=decrypted
SHARED_FOLDER=shared

# Security & Rate Limiting
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
RATELIMIT_DEFAULT=200 per day
RATELIMIT_STORAGE_URL=memory://
